{
  "name": "jellywave",
  "version": "1.0.1",
  "description": "A sleek, Spotify-style desktop client for your own Jellyfin music server",
  "main": "main.js",
  "author": "",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "electron": "^32.0.0",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.2"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/local-notifications": "^8.2.1",
    "@capacitor/preferences": "^8.0.1",
    "@capgo/capacitor-media-session": "^8.0.29",
    "@flaticon/flaticon-uicons": "^3.3.1",
    "@fontsource/poppins": "^5.3.0",
    "@xhayper/discord-rpc": "^1.3.4"
  },
  "build": {
    "appId": "com.jellywave.app",
    "productName": "JellyWave",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "update-checker.js",
      "src/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
